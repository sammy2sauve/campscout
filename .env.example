# Recreation.gov RIDB API — https://ridb.recreation.gov/
RECREATION_GOV_API_KEY=

# NPS API — https://www.nps.gov/subjects/developer/
NPS_API_KEY=

# NOAA APIs (api.weather.gov, NDBC) generally do not require a key
# NOAA_USER_AGENT=campscout (contact@example.com)

# PostgreSQL with PostGIS extension enabled
DATABASE_URL=postgresql://user:password@localhost:5432/campscout
